@prefix sd: <https://muze.nl/ns/spiral-developer#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix project: <https://github.com/simplyedit/simplystore/spiral#> .
@prefix culture: <https://muze.nl/ns/spiral-developer/culture/> .
@prefix spiral: <https://muze.nl/projects/spiral-developer/> .

project:CTX-001
    a sd:ProjectContext ;
    dcterms:identifier "CTX-001" ;
    sd:repositoryPath ".spiral/project-context.md" ;
    sd:status sd:Active ;
    sd:productionReadinessFocus "Developers evaluating, using or extending SimplyStore; the UI prioritizes query/exploration developers, then maintenance administrators, then extended administration. Public-query suitability remains a future evaluation target." ;
    sd:derivedFrom [
        a sd:ArtifactReference ;
        sd:artifact project:SRC-20260919-TTZ7C-43 ;
        sd:gitCommit "79fcf670d4558c75b9933743e6f2ea5616221eb0"
    ] ;
    sd:derivedFrom [ a sd:ArtifactReference ; sd:artifact project:SRC-20260923-TTZ7C-45 ; sd:gitCommit "46fb22fe5c4fecbb23c3b8d3b59e5ff6e58e11c2" ] ;
    sd:transforms [ a sd:ArtifactReference ; sd:artifact project:CTX-001 ; sd:gitCommit "9515993531c55176e1c3444f71dc3a23d5172df0" ] ;
    sd:developerEvaluationReadinessBar "Developers should be able to evaluate bounded durability claims from invariants, executable tests, evidence artifacts, explicit failure behavior, and documented known gaps." ;
    sd:hasAudience project:AUD-DEVELOPERS, project:AUD-END-USERS, project:AUD-OPERATORS ;
    sd:hasDownstreamProject project:DOWNSTREAM-CURRICULUM-STORE ;
    sd:adoptsCulture [
        a sd:ArtifactReference ;
        sd:artifact culture:CUL-MUZE-001 ;
        sd:gitCommit "9958f0e296e84169c21c02aa478ac4aae5a06a41"
    ], [
        a sd:ArtifactReference ;
        sd:artifact culture:CUL-MUZE-LIB-001 ;
        sd:gitCommit "9958f0e296e84169c21c02aa478ac4aae5a06a41"
    ] ;
    sd:adoptsWarningProfile [
        a sd:ArtifactReference ;
        sd:artifact spiral:WPF-HUMAN-001 ;
        sd:gitCommit "9958f0e296e84169c21c02aa478ac4aae5a06a41"
    ] .

project:AUD-DEVELOPERS
    a sd:ProjectAudience ;
    dcterms:identifier "developers" ;
    sd:priority "primary" ;
    dcterms:description "Developers using, evaluating, or extending SimplyStore." .

project:AUD-END-USERS
    a sd:ProjectAudience ;
    dcterms:identifier "end-users" ;
    sd:priority "downstream-context" ;
    dcterms:description "End users of systems built on SimplyStore; their UI needs remain specific to those downstream systems." .

project:AUD-OPERATORS
    a sd:ProjectAudience ;
    dcterms:identifier "operators" ;
    sd:priority "secondary" ;
    dcterms:description "Administrators checking status and performing standard maintenance, followed by extended schema, command, grants/accounts and audit work." .

project:DOWNSTREAM-CURRICULUM-STORE
    a sd:DownstreamProject ;
    dcterms:identifier "slonl/curriculum-store" ;
    dcterms:source <https://github.com/slonl/curriculum-store> ;
    sd:publicContext <https://opendata.slo.nl/curriculum/> ;
    sd:confidence "Human input plus public lookup on 2026-08-17; exact runtime dependency relationship has not been inspected." ;
    dcterms:description "Known downstream SimplyStore server with curriculum data, part of the SLO OpenData curriculum context according to human input." .
